# Google Business Profile API / OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Segredo forte para proteger a sincronização de avaliações
CRON_SECRET=

# Upstash Redis REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sistema de acesso administrativo e de usuários
# Gere um segredo aleatório com pelo menos 32 caracteres.
# Exemplo: openssl rand -base64 48
AUTH_SESSION_SECRET=

# E-mail do primeiro administrador (opcional; há um padrão interno)
DIVERTIN_ADMIN_EMAIL=

# Senha inicial do administrador: mínimo de 10 caracteres
DIVERTIN_ADMIN_PASSWORD=

# Serviço de e-mail SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Opcional: quando vazio, CONTACT_FROM utiliza SMTP_USER
CONTACT_FROM=

# Destinatário das mensagens do formulário
CONTACT_TO=

# Opcional: quando vazio, considera conexão segura se SMTP_PORT for 465
SMTP_SECURE=
